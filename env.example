# Website origin that hosts Vercel APIs (assignment, finance, invoices, notifications)
VITE_WEBSITE_API_URL=https://www.repairseries.in

# Firebase client (admin email/password auth — do not change)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned browser upload (never add API secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Do NOT add Cloudinary API secret here.
