rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
//
// Bootstrap: Create the first Super Admin manually in Firestore:
//   Collection: adminUsers
//   Document ID: <Firebase Auth UID of your admin>
//   Fields: name, email, role: "superAdmin", status: "active", createdAt (timestamp)

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function adminProfile() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    function isActiveAdmin() {
      return authed() && adminProfile().status == 'active';
    }

    function role() {
      return adminProfile().role;
    }

    function isSuperAdmin() {
      return isActiveAdmin() && role() == 'superAdmin';
    }

    function isTechnicianManager() {
      return isActiveAdmin() && role() == 'technicianManager';
    }

    function isBookingManager() {
      return isActiveAdmin() && role() == 'bookingManager';
    }

    function isServiceManager() {
      return isActiveAdmin() && role() == 'serviceManager';
    }

    function isSupportManager() {
      return isActiveAdmin() && role() == 'supportManager';
    }

    // Technician mobile app: `technicians/{docId}` doc id should match Firebase Auth uid
    // (or align your tech app with however you store `booking.technicianId`).
    function isTechnicianActor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/technicians/$(request.auth.uid));
    }

    function technicianOwnsBookingData(booking) {
      return isTechnicianActor() && booking.technicianId == request.auth.uid;
    }

    function customerOwnsBooking(booking) {
      return authed() && booking.customerId == request.auth.uid;
    }

    function technicianApprovalRequestPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'addOnApprovalRequest',
        'updatedAt',
      ]);
    }

    function technicianPausePatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'currentPause',
        'pauseHistory',
        'pausedAt',
        'resumedAt',
        'updatedAt',
      ])
      && (
        (resource.data.status == 'InProgress' && request.resource.data.status == 'Paused')
        || (resource.data.status == 'Paused' && request.resource.data.status == 'InProgress')
      );
    }

    function customerLocationPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'email',
        'phone',
        'address',
        'addresses',
        'lastUsedAddress',
        'photoURL',
        'photoUrl',
        'devicePushToken',
        'devicePushPlatform',
        'devicePushType',
        'pushToken',
        'pushTokenUpdatedAt',
        'latestLocation',
        'locationUpdatedAt',
        'notificationPrefs',
        'totalBookings',
        'updatedAt',
      ]);
    }

    // Customer may accept/reject extras. Money fields stay server-authoritative.
    function customerAddOnDecisionPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'addOnServices',
        'additionalServices',
        'addOnApprovalRequest',
        'extrasApprovalRequest',
        'serviceId',
        'serviceName',
        'replacedService',
        'serviceChangeHistory',
        'updatedAt',
      ]);
    }

    function bookingMoneyOrAssignmentKeys() {
      return [
        'technicianId',
        'technicianName',
        'technicianPhone',
        'assignedTechnicianId',
        'amount',
        'totalAmount',
        'finalBookingAmount',
        'finalAmount',
        'servicePrice',
        'technicianFinalEarning',
        'technicianEarning',
        'companyEarnings',
        'platformFeeAmount',
        'platformCommission',
        'customerPlatformFee',
        'gstAmount',
        'gstPercent',
        'gstEnabled',
        'financeFormulaVersion',
      ];
    }

    function customerBookingCreateAllowed() {
      return authed()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'New'
        && !request.resource.data.keys().hasAny([
          'technicianId',
          'technicianName',
          'technicianPhone',
          'assignedTechnicianId',
          'technicianFinalEarning',
          'technicianEarning',
          'companyEarnings',
          'platformFeeAmount',
          'platformCommission',
          'customerPlatformFee',
          'gstAmount',
          'gstPercent',
          'gstEnabled',
          'totalAmount',
          'finalBookingAmount',
          'finalAmount',
          'paymentStatus',
          'paymentVerified',
          'paidAt',
        ]);
    }

    function partnerSelfCreateAllowed() {
      return authed()
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.verificationStatus == 'pending';
    }

    function partnerSelfUpdateAllowed() {
      return request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended'])
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kyc'])
          || request.resource.data.kyc.status != 'approved'
          || resource.data.kyc.status == 'approved'
        );
    }

    function technicianJobPatchAllowed() {
      return technicianOwnsBookingData(resource.data)
        && request.resource.data.technicianId == resource.data.technicianId
        && request.resource.data.customerId == resource.data.customerId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(bookingMoneyOrAssignmentKeys());
    }

    // RS App payment confirmation is server-only via confirmCustomerPayment callable.
    // Do not allow clients to mark bookings paid.

    function customerRatingPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'customerRating',
        'ratedAt',
        'updatedAt',
      ])
      && resource.data.status == 'Completed'
      && !('customerRating' in resource.data)
      && request.resource.data.customerRating is int
      && request.resource.data.customerRating >= 1
      && request.resource.data.customerRating <= 5;
    }

    // Customer claims a free revisit: only revisit bookkeeping fields may change on the parent booking.
    function customerRevisitParentPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'revisitChildrenCount',
        'revisitHistory',
        'lastRevisitAt',
        'revisitRemaining',
        'remainingRevisits',
        'freeRevisitsRemaining',
        'revisitPolicy',
        'updatedAt',
      ]);
    }

    // Customer app/website links a client-generated invoice to their own booking.
    function customerInvoiceLinkPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'invoiceId',
        'invoiceNumber',
        'invoiceCreatedAt',
        'updatedAt',
      ]);
    }

    function customerOwnsBookingId(bookingId) {
      return authed()
        && bookingId is string
        && bookingId.size() > 0
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid;
    }

    function customerAssignmentPatchOnly() {
      return request.resource.data.customerId == resource.data.customerId
        && request.resource.data.status == 'Assigned'
        && (resource.data.status == 'New'
          || resource.data.status == 'Assigned'
          || resource.data.status == 'pending')
        && request.resource.data.technicianId is string
        && request.resource.data.technicianId.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'technicianId',
          'technicianName',
          'technicianPhone',
          'scheduledSlotDate',
          'scheduledSlotLabel',
          'scheduledSlotIndex',
          'scheduleDateKey',
          'scheduleSlotIndex',
          'reservedSlotIndices',
          'updatedAt',
        ]);
    }

    function customerBusySlotCreateAllowed() {
      return authed()
        && request.resource.data.reason == 'booking'
        && request.resource.data.status == 'busy'
        && request.resource.data.bookingId is string
        && request.resource.data.bookingId.size() > 0
        && request.resource.data.date is string
        && (request.resource.data.slotIndex is int || request.resource.data.slotIndex is float)
        && request.resource.data.slotIndex >= 1
        && request.resource.data.slotIndex <= 10
        && existsAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.technicianId == techId
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'Assigned';
    }

    function customerBusySlotDeleteAllowed() {
      return authed()
        && resource.data.reason == 'booking'
        && resource.data.bookingId is string
        && customerOwnsBookingId(resource.data.bookingId);
    }

    function customerBusySlotUpdateAllowed() {
      return authed()
        && resource.data.reason == 'booking'
        && request.resource.data.reason == 'booking'
        && request.resource.data.status == 'busy'
        && resource.data.bookingId == request.resource.data.bookingId
        && customerOwnsBookingId(resource.data.bookingId);
    }

    function customerReschedulePatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'scheduledAt',
        'scheduledSlotDate',
        'scheduledSlotLabel',
        'scheduledSlotIndex',
        'scheduleDateKey',
        'scheduleSlotIndex',
        'slotStartHour',
        'date',
        'time',
        'slot',
        'bookingDate',
        'updatedAt',
        'rescheduledAt',
      ])
        && request.resource.data.customerId == resource.data.customerId;
    }

    function customerCancelPatchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'cancelledBy',
        'cancelledAt',
        'updatedAt',
      ])
        && request.resource.data.status == 'Cancelled'
        && request.resource.data.customerId == resource.data.customerId;
    }

    match /adminUsers/{userId} {
      allow read: if authed() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    match /customers/{docId} {
      allow read: if isSuperAdmin() || isBookingManager() || isSupportManager()
        || (authed() && request.auth.uid == docId);
      allow create: if isSuperAdmin() || (authed() && request.auth.uid == docId);
      allow update: if isSuperAdmin()
        || isBookingManager()
        || isSupportManager()
        || (authed() && request.auth.uid == docId && customerLocationPatchOnly());
      allow delete: if isSuperAdmin();
    }

    match /customers/{customerId}/locationHistory/{historyId} {
      allow read: if isSuperAdmin() || isBookingManager() || isSupportManager()
        || (authed() && request.auth.uid == customerId);
      allow create: if authed()
        && request.auth.uid == customerId
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      allow update, delete: if false;
    }

    match /technicians/{docId} {
      // Not world-readable. Signed-in customers need location/category for slot ranking.
      allow read: if authed();
      allow create: if isSuperAdmin() || isTechnicianManager()
        || (authed() && request.auth.uid == docId && partnerSelfCreateAllowed());
      allow update: if isSuperAdmin() || isTechnicianManager()
        || (authed() && request.auth.uid == docId && partnerSelfUpdateAllowed());
      allow delete: if isSuperAdmin() || isTechnicianManager();
    }

    match /technicians/{techId}/busySlots/{slotId} {
      allow read: if authed();
      allow create: if isSuperAdmin() || isBookingManager() || isTechnicianManager()
        || (isTechnicianActor() && request.auth.uid == techId
          && request.resource.data.reason != 'booking')
        || customerBusySlotCreateAllowed();
      allow update: if isSuperAdmin() || isBookingManager() || isTechnicianManager()
        || (isTechnicianActor() && request.auth.uid == techId
          && resource.data.reason != 'booking'
          && request.resource.data.reason != 'booking')
        || customerBusySlotUpdateAllowed();
      allow delete: if isSuperAdmin() || isBookingManager() || isTechnicianManager()
        || (isTechnicianActor() && request.auth.uid == techId
          && resource.data.reason != 'booking')
        || customerBusySlotDeleteAllowed();
    }

    match /technicians/{techId}/transactions/{txId} {
      allow read: if isSuperAdmin() || isBookingManager() || isTechnicianManager()
        || (isTechnicianActor() && request.auth.uid == techId);
      allow create: if isSuperAdmin() || isBookingManager() || isTechnicianManager();
      allow update, delete: if false;
    }

    match /technicians/{techId}/payoutRequests/{id} {
      allow create: if isTechnicianActor() && request.auth.uid == techId;
      allow read: if isSuperAdmin() || isTechnicianManager()
        || (isTechnicianActor() && request.auth.uid == techId);
      allow update: if isSuperAdmin() || isTechnicianManager();
      allow delete: if false;
    }

    match /bookings/{docId} {
      allow read: if isSuperAdmin() || isBookingManager() || isTechnicianManager() || isSupportManager()
        || technicianOwnsBookingData(resource.data)
        || customerOwnsBooking(resource.data);
      allow create: if isSuperAdmin() || isBookingManager()
        || customerBookingCreateAllowed();
      allow update: if isSuperAdmin() || isBookingManager() || isSupportManager()
        || technicianJobPatchAllowed()
        || (technicianOwnsBookingData(resource.data)
            && request.resource.data.technicianId == resource.data.technicianId
            && request.resource.data.customerId == resource.data.customerId
            && (
              technicianApprovalRequestPatchOnly()
              || technicianPausePatchOnly()
            ))
        || (customerOwnsBooking(resource.data)
            && request.resource.data.customerId == resource.data.customerId
            && (
              customerReschedulePatchOnly()
              || customerCancelPatchOnly()
              || customerAssignmentPatchOnly()
              || (
                request.resource.data.technicianId == resource.data.technicianId
                && (
                  customerAddOnDecisionPatchOnly()
                  || customerRatingPatchOnly()
                  || customerRevisitParentPatchOnly()
                  || customerInvoiceLinkPatchOnly()
                )
              )
            ));
      allow delete: if isSuperAdmin() || isBookingManager();
    }

    // Customer catalog (app + website) — public read; writes stay admin-only.
    match /services/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    // Technician-only catalog (not customer-facing services). Filter by `categoryId` in app.
    match /additionalServices/{docId} {
      allow read: if isSuperAdmin() || isBookingManager() || isServiceManager() || isTechnicianActor();
      allow write: if isSuperAdmin() || isServiceManager();
    }

    // Queued by admin panel; Cloud Function sends FCM (admin SDK bypasses these rules).
    match /bookingNotificationOutbox/{docId} {
      allow create: if isSuperAdmin() || isBookingManager() || isSupportManager();
      allow read: if isSuperAdmin() || isBookingManager();
      allow update, delete: if false;
    }

    // Admin broadcast queue (title/body/segment) for later processing by Cloud Function / ops.
    match /broadcastNotifications/{docId} {
      allow create, read: if isSuperAdmin() || isBookingManager();
      allow update, delete: if isSuperAdmin();
    }

    match /faqs/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    match /offers/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    // Section banners for user app + website (public read of catalog media)
    match /banners/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    // CMS home layout sections for user app + website
    match /homeSections/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isServiceManager();
    }

    match /coupons/{docId} {
      // Admins manage coupons; authenticated customers may read active codes for checkout.
      allow read: if isSuperAdmin() || isBookingManager() || isServiceManager()
        || (authed() && (!('active' in resource.data) || resource.data.active != false));
      allow write: if isSuperAdmin() || isServiceManager();
      allow update: if isSuperAdmin() || isServiceManager();

      match /couponRedemptions/{redemptionId} {
        allow read: if isSuperAdmin() || isServiceManager() || isBookingManager()
          || (authed() && resource.data.customerId == request.auth.uid);
        allow create: if authed()
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.keys().hasAll(['customerId', 'redeemedAt']);
        allow update, delete: if isSuperAdmin();
      }
    }

    match /supportTickets/{ticketId} {
      allow read: if isSuperAdmin() || isSupportManager()
        || (authed() && resource.data.customerId == request.auth.uid);
      allow create: if authed()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasAll(['customerId', 'subject', 'status', 'createdAt']);
      allow update: if isSuperAdmin() || isSupportManager()
        || (authed()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId);
      allow delete: if isSuperAdmin();
    }

    match /customers/{customerId}/notifications/{notifId} {
      allow read: if isSuperAdmin() || isSupportManager()
        || (authed() && request.auth.uid == customerId);
      allow create: if isSuperAdmin() || isSupportManager()
        || (authed() && request.auth.uid == customerId);
      allow update: if isSuperAdmin() || isSupportManager()
        || (authed() && request.auth.uid == customerId);
      allow delete: if isSuperAdmin()
        || (authed() && request.auth.uid == customerId);
    }

    match /userNotifications/{docId} {
      allow read: if isSuperAdmin() || isSupportManager()
        || (authed() && resource.data.userId == request.auth.uid);
      allow create: if isSuperAdmin() || isSupportManager()
        || (authed() && request.resource.data.userId == request.auth.uid);
      allow update: if isSuperAdmin() || isSupportManager()
        || (authed() && resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin()
        || (authed() && resource.data.userId == request.auth.uid);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin()
        || (isTechnicianManager() && (docId == 'ranking' || docId == 'scheduling'));
    }

    // Tax invoices — written only by Next.js Admin SDK API (Spark-safe).
    // Customers may read their own invoice metadata (incl. Cloudinary PDF URL). Technicians cannot.
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isBookingManager() || isSupportManager()
        || (authed() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
